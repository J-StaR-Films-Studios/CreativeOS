# Normalize line endings across Windows/WSL/macOS clones.
# Prevents accidental CRLF-only mega-diffs from getting committed.
* text=auto

# Source/config/docs should stay stable in diffs.
*.py text eol=lf
/00_System/Bin/cos text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary/media assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.mov binary
*.mp3 binary
*.wav binary
*.pdf binary
*.zip binary
*.7z binary
*.rar binary
